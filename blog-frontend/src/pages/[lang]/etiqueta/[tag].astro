---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogCard from "../../../components/BlogCard.astro";
import { fetchPosts } from "../../../lib/blog";

export async function getStaticPaths() {
  const [postsEs, postsEn] = await Promise.all([fetchPosts("es"), fetchPosts("en")]);

  const paths: { params: { lang: string; tag: string } }[] = [];

  for (const [urlLang, posts] of [["es", postsEs], ["en", postsEn]] as const) {
    const slugs = [...new Set(posts.flatMap((p) => p.tags.map((tg) => tg.slug)))];
    slugs.forEach((slug) => paths.push({ params: { lang: urlLang, tag: slug } }));
  }

  return paths;
}

const { lang, tag } = Astro.params as { lang: "es" | "en"; tag: string };

const posts = await fetchPosts(lang);
const filtered = posts
  .filter((post) => post.tags.some((tg) => tg.slug === tag))
  .sort((a, b) => new Date(b.publishedAt).valueOf() - new Date(a.publishedAt).valueOf());

const tagName = filtered[0]?.tags.find((tg) => tg.slug === tag)?.name ?? tag;
---

<BaseLayout title={`#${tagName} | ZOOBLOG`}>
  <section class="min-h-screen bg-gradient-to-br from-emerald-50 via-white to-sky-50 px-6 py-24">
    <div class="mx-auto max-w-6xl">

      <div data-scroll-reveal class="mb-14">
        <a
          href={`/${lang}/blog`}
          class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-bold text-slate-600 shadow-sm transition hover:text-emerald-700"
        >
          ← {lang === "es" ? "Volver al blog" : "Back to blog"}
        </a>

        <span class="mt-6 inline-flex rounded-full bg-emerald-100 px-4 py-2 text-sm font-bold text-emerald-700">
          {lang === "es" ? "Etiqueta" : "Tag"}
        </span>

        <h1 class="mt-4 text-5xl font-black tracking-tight text-slate-950 md:text-6xl">
          #{tagName}
        </h1>

        <p class="mt-4 text-lg text-slate-600">
          {filtered.length} {lang === "es" ? "artículos" : "articles"}
        </p>
      </div>

      {filtered.length > 0 ? (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {filtered.map((post) => (
            <div data-scroll-reveal>
              <BlogCard post={post} lang={lang} />
            </div>
          ))}
        </div>
      ) : (
        <p class="rounded-2xl bg-white p-8 text-slate-500 shadow-lg">
          {lang === "es" ? "No hay artículos con esta etiqueta." : "No articles with this tag."}
        </p>
      )}

    </div>
  </section>
</BaseLayout>
